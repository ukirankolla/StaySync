# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENV=development
# Absolute base URL of this API in production (e.g. https://backend.up.railway.app)
PUBLIC_BASE_URL=

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
# SQLite (default, dev): leave as is or set to another SQLite path
DATABASE_URL=sqlite:///./staysync.db
# Supabase / Postgres (production):
# DATABASE_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres

# --- CORS (comma separated) ---
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production: add your Vercel domain
# CORS_ORIGINS=https://staysync.vercel.app

# --- OTP email (optional; leave SMTP_HOST empty to log codes to console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=StaySync <no-reply@staysync.local>
SMTP_USE_TLS=true

# --- Upload storage ---
# "local" writes uploads to ./uploads (dev / Railway volume)
# "supabase" uploads to Supabase Storage (recommended for production)
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=staysync
