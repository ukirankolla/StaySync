# Copy to .env and fill in real values. Never commit .env.

# --- App ---
# Defaults to "production" when unset. Use "development" for local work (enables dev OTP codes, relaxed checks).
ENV=development
# Absolute base URL of this API in production (e.g. https://backend.up.railway.app)
PUBLIC_BASE_URL=

# --- Security ---
# REQUIRED in production: 32+ random characters (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# A weak/missing secret is replaced by a random one at boot, which logs everyone out on each restart.
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created on first boot in production. Must be a strong, non-default password (10+ chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Wipes and reseeds the DB when SEED_RESET=true. Ignored in production unless ALLOW_SEED_RESET=true.
ALLOW_SEED_RESET=false

# --- Database ---
# SQLite (default, dev): leave as is or set to another SQLite path
DATABASE_URL=sqlite:///./staysync.db
# Supabase / Postgres (production):
# DATABASE_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres

# --- CORS (comma separated) ---
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Preview/production Vercel domains matching this regex are also allowed (override if you use a custom domain):
# CORS_ORIGIN_REGEX=^https://stay-?sync[a-z0-9-]*\.vercel\.app$
# Production: add your Vercel domain
# CORS_ORIGINS=https://staysync.vercel.app

# --- OTP email (optional; leave SMTP_HOST empty to log codes to console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=StaySync <no-reply@staysync.local>
SMTP_USE_TLS=true

# --- Upload storage ---
# "local" writes uploads to ./uploads (dev / Railway volume)
# "supabase" uploads to Supabase Storage (recommended for production)
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=staysync
