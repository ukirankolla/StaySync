{
  "name": "staysync-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mobile:sync": "node scripts/require-api-url.mjs && vite build && cap sync",
    "mobile:android": "node scripts/require-api-url.mjs && vite build && cap sync android && cap open android",
    "mobile:ios": "node scripts/require-api-url.mjs && vite build && cap sync ios && cap open ios",
    "icons": "python3 scripts/generate_icons.py"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
