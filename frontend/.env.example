# Copy to .env and fill in. Vite env vars are baked in at build time
# (set them in Vercel Project Settings > Environment Variables).

# Base URL of the deployed backend. Leave empty in development
# (Vite dev server proxies /api to http://127.0.0.1:8000).
# Example (production):
# VITE_API_URL=https://backend.up.railway.app
VITE_API_URL=
