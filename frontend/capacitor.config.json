{
  "appId": "com.staysync.app",
  "appName": "StaySync",
  "webDir": "dist",
  "backgroundColor": "#0f172a",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0f172a"
  },
  "android": {
    "backgroundColor": "#0f172a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": false,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
